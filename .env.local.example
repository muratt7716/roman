NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — RLS bypass eder, ASLA client'a sızdırılmaz (NEXT_PUBLIC_ öneki yok).
# Supabase Dashboard > Settings > API > service_role. Hesap silme (/api/account/delete)
# auth.admin.deleteUser çağrısı için bunu zorunlu tutar; anon key ile yapılamaz.
# Vercel > Project Settings > Environment Variables'a da eklenmeli.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI Studio — AI yazma önerisi ve karakter derinleştirme (opsiyonel,
# yoksa ilgili route'lar sessizce null döner)
GEMINI_API_KEY=your-gemini-key

# Vercel Cron isteklerini doğrulamak için rastgele bir dize
CRON_SECRET=your-cron-secret
